<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Capstone - Secrets</title>
</head>
<body>
    <form action="/api/add" method="POST">
        <input type="hidden" name="user_id" value="<%= id %>">
        <label for="secret">Secret: </label><input id="secret-input" type="text" name="secret" required><br>
        <button type="submit">Add</button>
    </form>

    <% if(locals.secrets_on_page){ %>
        <% secrets_on_page.forEach(secret => { %>
            <div class="secret">
                <p> <%= secret.secret %> </p>
            </div>
        <% }); %>
    <% } %>
</body>
</html>