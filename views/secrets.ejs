<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Capstone - Secrets</title>
    <link rel="stylesheet" href="/styles/style.css">
</head>
<body>
    <div class="container">
        <h1>Your Secrets</h1>
        <form action="/logout" method="POST">
            <button type="submit">Logout</button>
        </form>

        <form action="/dashboard" method="POST">
            <input type="hidden" name="user_id" value="<%= user ? user.user_id : '' %>">
            <label for="secret">Secret: </label><input id="secret-input" type="text" name="secret" value="" required><br>
            <button type="submit">Add</button>
        </form>

        <% if(locals.secrets_on_page){ %>
            <% secrets_on_page.forEach(secret => { %>
                <div class="secret">
                    <p> <%= secret.secret %> </p>
                    <form action="/dashboard/delete" method="GET">
                        <input type="hidden" name="secret_id" value="<%= secret.secret_id %>">
                        <input type="hidden" name="user_id" value="<%= user ? user.user_id : '' %>">
                        <button type="submit">Delete</button>
                    </form>
                </div>
            <% }); %>
        <% } %>
    </div>
</body>
</html>